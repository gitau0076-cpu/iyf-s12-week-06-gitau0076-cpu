async function fetchJson(endpoint) {
    const response = await fetch(`https://jsonplaceholder.typicode.com/${endpoint}`);

    if (!response.ok) {
        throw new Error(`${endpoint} failed with HTTP ${response.status}`);
    }

    return response.json();
}

const endpoints = ["users/1", "posts/1", "todos/1"];

const requests = endpoints.map(endpoint =>
    fetchJson(endpoint)
        .then(data => {
            console.log(`Completed ${endpoint}:`, data);
            return data;
        })
        .catch(error => {
            console.error(`Failed ${endpoint}:`, error.message);
            throw error;
        })
);

Promise.allSettled(requests).then(results => {
    const successful = results.filter(result => result.status === "fulfilled").length;
    console.log(`All requests settled: ${successful} of ${results.length} succeeded.`);
});
